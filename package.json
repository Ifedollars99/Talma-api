{
  "name": "talma",
  "version": "1.0.0",
  "private": true,
  "description": "Talma — a social learning platform for students and lecturers.",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c cyan,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "npm run dev --workspace client",
    "dev:server": "npm run dev --workspace server",
    "build": "npm run build --workspace server && npm run build --workspace client",
    "build:client": "npm run build --workspace client",
    "build:server": "npm run build --workspace server",
    "typecheck": "npm run typecheck --workspace server && npm run typecheck --workspace client",
    "lint": "npm run lint --workspace server && npm run lint --workspace client",
    "test": "npm run test --workspace server",
    "seed": "npm run seed --workspace server",
    "make:admin": "npm run make:admin --workspace server",
    "email:setup": "npm run email:setup --workspace server",
    "email:test": "npm run email:test --workspace server --",
    "email:preview": "npm run email:preview --workspace server",
    "generate:pdfs": "node scripts/generate-course-pdfs.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "pdf-lib": "^1.17.1"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
