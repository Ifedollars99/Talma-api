# ---------------------------------------------------------------------------
# Talma web client — environment template
# Copy to `.env` (or `.env.local`) and fill in the values you need.
# ---------------------------------------------------------------------------

# Base URL of the Talma API.
# Leave this as `/api` to use the Vite dev proxy (or a reverse proxy in
# production) so the refresh-token cookie stays same-origin.
VITE_API_BASE_URL=/api

# Where the Vite dev server proxies `/api` and `/uploads` requests.
VITE_API_PROXY_TARGET=http://localhost:4000

# Dev server port.
VITE_PORT=5173
