# ---------------------------------------------------------------------------
# Talma API — environment template
# Copy to `.env` and fill in real values. NEVER commit the real `.env`.
# ---------------------------------------------------------------------------

# HTTP server
NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# Comma-separated list of allowed browser origins (the Vite dev server).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# MongoDB — local Docker (docker compose up -d) or MongoDB Atlas.
MONGODB_URI=mongodb://127.0.0.1:27017/talma

# JWT signing secrets. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-me-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-me-with-a-different-long-random-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Refresh-token cookie. `secure` should be true in production (HTTPS only).
REFRESH_COOKIE_NAME=talma_refresh
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=lax

# Set to true to require students to confirm their email address before signing in.
AUTH_REQUIRE_EMAIL_VERIFICATION=false

# ---------------------------------------------------------------------------
# Transactional email
# ---------------------------------------------------------------------------
# Provider: auto | resend | smtp | ethereal | console
# - auto: Resend when RESEND_API_KEY is set, then SMTP when SMTP_HOST is set,
#         then Ethereal in development, otherwise the local console.
# - resend: recommended for production. Create a key at https://resend.com,
#           then verify the sending domain and set MAIL_FROM to an address on
#           that domain.
# - smtp: works with Gmail app passwords, SendGrid, Mailgun, Postmark, etc.
# - ethereal: a throwaway development inbox. No account is needed; every sent
#             email gets a preview URL in the API log and in the creator modal.
# - console: logs the message instead of sending it (test/production fallback).
EMAIL_PROVIDER=auto

# Resend (recommended). From the project root, run `npm run email:setup` to
# fill in the key and sender interactively.
RESEND_API_KEY=
MAIL_FROM="Talma <onboarding@resend.dev>"
MAIL_REPLY_TO=

# SMTP fallback (used when EMAIL_PROVIDER=smtp, or auto with no Resend key)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Public base URL of the API — used to build absolute media URLs.
PUBLIC_API_URL=http://localhost:4000

# Where the React app is served. Paystack sends buyers back to /mycamp here.
CLIENT_APP_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# Paid video library (Paystack)
# ---------------------------------------------------------------------------
# Get these from https://dashboard.paystack.com/#/settings/developers.
# Leave the secret key empty to disable purchases locally; the catalogue and
# admin tools still work.
PAYSTACK_SECRET_KEY=
PAYSTACK_CURRENCY=NGN
# Optional override for the redirect after checkout. Defaults to
# `${CLIENT_APP_URL}/mycamp`.
PAYSTACK_CALLBACK_URL=
# Default video price in kobo (200000 kobo = ₦2,000).
VIDEO_DEFAULT_PRICE_KOBO=200000
# Public webhook URL (HTTPS in production):
#   https://your-api-domain.com/api/payments/paystack/webhook
# During local development expose the API with ngrok/cloudflared and paste the
# HTTPS URL into the Paystack dashboard.

# ---------------------------------------------------------------------------
# YouTube uploads (approved creators)
# ---------------------------------------------------------------------------
# 1. Create a Google Cloud project and enable "YouTube Data API v3".
# 2. Configure the OAuth consent screen (External; Testing is fine for a small
#    team, but testing refresh tokens expire after 7 days).
# 3. Create an OAuth client of type "Desktop app".
# 4. Put the client id/secret below, then run:
#      npm run youtube:auth --workspace server
# 5. Paste the printed refresh token and channel id here and restart the API.
#
# The Google account authorizing this must own the Talma YouTube channel. The
# channel must be phone-verified to upload videos longer than 15 minutes.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
# Required for uploads: Talma refuses any video that lands on another channel.
# The auth helper prints this too; you can also find it in YouTube Studio →
# Settings → Channel → Advanced settings.
YOUTUBE_CHANNEL_ID=
# 27 = Education (https://developers.google.com/youtube/v3/docs/videoCategories).
YOUTUBE_CATEGORY_ID=27
# Maximum creator upload size in bytes. 4 GiB is enough for an hour of HD video.
VIDEO_MAX_UPLOAD_BYTES=4294967296
# The platform's percentage of each sale. Creators receive the remainder.
# 30 means a ₦2,000 sale pays the creator ₦1,400 (before any tax).
PLATFORM_VIDEO_SHARE_PERCENT=30

# Where uploaded media is written to (relative paths are resolved from server/).
UPLOAD_DIR=uploads

# Comma-separated allowed upload MIME types.
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/gif,image/webp,video/mp4,video/webm,application/pdf
# Max upload size in megabytes.
UPLOAD_MAX_MB=25

# Log level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Talma AI assistant
# ---------------------------------------------------------------------------
# Paste an OpenAI (or OpenAI-compatible) API key here to power the assistant.
# Leave empty and the app falls back to the free Pollinations text model.
OPENAI_API_KEY=
# Any OpenAI-compatible endpoint, e.g. https://api.openai.com/v1
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# Upper bound on the assistant's reply length, in tokens.
AI_MAX_OUTPUT_TOKENS=1600
# Pictures need a vision-capable model. The free model is text-only.
# Free vision options (OpenAI-compatible):
#   Gemini: OPENAI_API_KEY=<AI Studio key>
#           OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#           OPENAI_MODEL=gemini-2.5-flash
#   Groq:   OPENAI_BASE_URL=https://api.groq.com/openai/v1
#           OPENAI_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
# Set to false if the configured server model cannot read pictures.
AI_VISION_ENABLED=true

# Free, no-key fallback used when OPENAI_API_KEY is empty.
# Pollinations is rate-limited to one reply every 30 seconds per IP.
# Set to false in production once a real key is configured.
FREE_AI_ENABLED=true
FREE_AI_BASE_URL=https://text.pollinations.ai/v1
FREE_AI_MODEL=openai-fast
